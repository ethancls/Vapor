[Unit]
Description=Vapor Backend API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/vapor/backend
EnvironmentFile=/etc/vapor/backend.env
ExecStart=/opt/vapor/venv/bin/gunicorn -c /opt/vapor/backend/deploy/gunicorn.conf.py main:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/vapor/backend

[Install]
WantedBy=multi-user.target
