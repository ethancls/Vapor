VAPOR_APP_NAME=Vapor
VAPOR_LOG_LEVEL=INFO
VAPOR_LOG_FORMAT=json
VAPOR_CORS_ORIGINS=https://app.example.com
VAPOR_TRUSTED_HOSTS=api.example.com
VAPOR_AUTH_ENABLED=true
VAPOR_AUTH_READ_TOKENS=replace-with-read-token
VAPOR_AUTH_WRITE_TOKENS=replace-with-write-token
VAPOR_EXPOSE_INTERNAL_ERRORS=false
VAPOR_MAX_REQUEST_BODY_BYTES=2097152
VAPOR_ACTIVITY_DB_PATH=activity.db
VAPOR_ACTIVITY_RETENTION=5000
VAPOR_POLL_INTERVAL_SECONDS=5
