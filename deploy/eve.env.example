# Eve — Go backend configuration
# Copy to /etc/eve/eve.env

EVE_BIND=0.0.0.0:8100
EVE_SESSION_TTL=24h
EVE_LOG_LEVEL=info
EVE_LOG_FORMAT=text

EVE_CONTAINER_BINARY=container
EVE_CONTAINER_TIMEOUT=45s
EVE_CONTAINER_CONCURRENCY=6
EVE_INSTANCES_CACHE_TTL=2s
EVE_POLL_INTERVAL=5s

EVE_JWT_SECRET=replace-with-a-random-secret
EVE_DB_PATH=/var/lib/eve/eve.db
EVE_ACTIVITY_RETENTION=5000
